      "id": "step-1",
      "title": "휴가 정보 입력",
      "description": "휴가 날짜와 사유를 입력하세요",
      "checklist": [
        {
          "id": "check-1",
          "text": "내 연차 잔여 일수 확인 완료",
          "required": true
        },
        {
          "id": "check-2",
          "text": "팀 일정 확인 (중요 회의, 마감일 등)",
          "required": true
        },
        {
          "id": "check-3",
          "text": "업무 인수인계 계획 수립",
          "required": true
        }
      ],
      "fields": [
        {
          "id": "field-1",
          "type": "date",
          "label": "휴가 시작일",
          "required": true
        },
        {
          "id": "field-2",
          "type": "date",
          "label": "휴가 종료일",
          "required": true
        },
        {
          "id": "field-3",
          "type": "number",
          "label": "사용 연차 일수",
          "required": true,
          "placeholder": "1"
