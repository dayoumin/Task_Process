{
  "name": "task-process-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Task Process Management System - Monorepo",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "cd tests && npx playwright test",
    "test:e2e:ui": "cd tests && npx playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:ui": "vitest --ui",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "turbo type-check",
    "clean": "turbo clean && pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "postinstall": "pnpm --filter @task-process/shared-types build"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "^1.57.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@turbo/gen": "^2.3.3",
    "@vitest/ui": "^4.0.16",
    "happy-dom": "^15.11.7",
    "jsdom": "^27.4.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "typescript": "5.7.2",
      "zod": "3.24.1",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "vitest": "2.1.9",
      "@vitest/ui": "2.1.9"
    }
  }
}
